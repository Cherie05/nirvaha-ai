NODE_ENV=development
PORT=3000

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nirvaha
POSTGRES_PASSWORD=nirvaha_dev_pw
POSTGRES_DB=nirvaha

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
SCAN_CACHE_TTL_SECONDS=86400

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=nirvaha
MINIO_ROOT_PASSWORD=nirvaha_dev_pw
MINIO_BUCKET=nirvaha-scans
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# Gemini — THE ONLY REAL SECRET
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TOTAL_BUDGET_MS=45000

# AI Provider Orchestration
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_MS=45000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP=true
OLLAMA_MAX_IMAGE_PX=768
OLLAMA_CONFIDENCE_THRESHOLD=0.75

# Auth
JWT_SECRET=change_me_in_env
JWT_EXPIRES_IN=7d

# Anonymous scan (set false in production)
ALLOW_ANONYMOUS_SCAN=true

# ngrok public tunnel (profile "tunnel") — get a token at dashboard.ngrok.com
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Fixed demo login (no signup). OTP screen accepts DEMO_OTP.
DEMO_EMAIL=test@gmail.com
DEMO_PASSWORD=test@1234
DEMO_DISPLAY_NAME=Test User
DEMO_OTP=123456
ALLOW_REGISTRATION=false
